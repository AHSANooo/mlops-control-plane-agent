# MLOps AI Agent Environment Configuration
# Copy this file to .env and configure the credentials for local or production use.

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Apache Airflow
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TOKEN=

# Kubernetes Operations
KUBERNETES_NAMESPACE=mlops-prod
KUBECONFIG=~/.kube/config

# DVC Workspace
DVC_REPO_DIR=.

# LLM Orchestrator Configuration
# Set OPENAI_API_KEY or GEMINI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Logging & Telemetry
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8001
